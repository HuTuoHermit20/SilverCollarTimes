.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 200rpx;
}

.calendar-bar {
  background: var(--bg-card);
  padding: 16rpx 0;
}

.calendar-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 16rpx;
}

.calendar-day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  margin: 0 4rpx;
  min-width: 80rpx;
}

.calendar-day.today {
  background: rgba(74,144,217,0.08);
}

.calendar-day.selected {
  background: var(--primary);
}

.calendar-day.selected .cal-day-name,
.calendar-day.selected .cal-day-num {
  color: #FFF;
}

.cal-day-name {
  font-size: 20rpx;
  color: var(--text-hint);
}

.cal-day-num {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.cal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 6rpx;
}

.cal-dot.green { background: var(--success); }
.cal-dot.orange { background: var(--warning); }
.cal-dot.gray { background: var(--text-hint); }

.plan-list {
  padding: 16rpx 24rpx;
}

.plan-card {
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
}

.plan-time {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary);
}

.plan-medicine {
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 8rpx;
}

.plan-slot {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.plan-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-btn {
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(74,144,217,0.08);
}

.action-btn.danger {
  color: var(--danger);
  background: rgba(255,59,48,0.08);
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: var(--bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
