.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
}

/* SOS 横幅 */
.sos-banner {
  background: #FF3B30;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  animation: sosPulse 1.5s ease-in-out infinite;
}

@keyframes sosPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.sos-banner-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.sos-banner-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.sos-banner-text {
  flex: 1;
}

.sos-banner-title {
  color: #FFF;
  font-size: 30rpx;
  font-weight: bold;
}

.sos-banner-desc {
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.sos-banner-btn {
  background: rgba(255,255,255,0.25);
  color: #FFF;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 问候区 */
.greeting-section {
  padding: 32rpx 32rpx 16rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #7AB8F5 100%);
  color: #FFF;
}

.greeting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: bold;
}

.weather-info {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
}

.date-text {
  font-size: 26rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.weather-tip {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.85;
  font-style: italic;
}

/* 设备卡片 */
.device-card {
  margin-top: -8rpx;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
}

.device-icon {
  font-size: 56rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
}

.battery-info {
  font-size: 24rpx;
  font-weight: 500;
}

.battery-blink {
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.env-info {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 未绑定 */
.unbind-card {
  text-align: center;
  padding: 48rpx 24rpx;
  border: 2rpx dashed var(--border);
  background: transparent;
  box-shadow: none;
}

.unbind-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFF;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.unbind-text {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 500;
}

.unbind-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 服药概览 */
.medication-overview {
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.progress-area {
  display: flex;
  align-items: center;
}

.progress-ring {
  flex-shrink: 0;
  margin-right: 32rpx;
}

.ring-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-inner {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.ring-count {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

.ring-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.progress-status {
  flex: 1;
}

.status-complete {
  font-size: 28rpx;
  color: var(--success);
}

.like-animation {
  font-size: 48rpx;
  margin-top: 8rpx;
  animation: bounce 0.6s ease infinite alternate;
}

@keyframes bounce {
  from { transform: scale(1); }
  to { transform: scale(1.3); }
}

.status-missed {
  font-size: 28rpx;
}

.status-upcoming, .status-waiting {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 最近服药 */
.recent-record {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 12rpx;
}

.record-snapshot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.snapshot-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.snapshot-name {
  font-size: 26rpx;
  flex: 1;
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.action-item {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow);
  position: relative;
  transition: transform 0.15s;
}

.action-item:active {
  transform: scale(0.96);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.action-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
}

/* 健康小贴士 */
.health-tip {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(74, 144, 217, 0.08);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.tip-content {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary-dark);
  line-height: 1.6;
}

.tip-close {
  font-size: 28rpx;
  color: var(--text-hint);
  padding: 8rpx;
  margin-left: 16rpx;
}
