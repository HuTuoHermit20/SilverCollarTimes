.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.sos-header {
  background: linear-gradient(135deg, #FF3B30 0%, #FF6B6B 100%);
  padding: 48rpx 32rpx;
  text-align: center;
  color: #FFF;
}

.sos-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  margin: 0 auto 16rpx;
}

.sos-title {
  font-size: 36rpx;
  font-weight: bold;
}

.sos-time {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.sos-info {
  padding: 8rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.info-value {
  font-size: 26rpx;
  font-weight: 500;
}

.sos-actions {
  padding: 32rpx 24rpx;
}

.sos-tips {
  margin: 0 24rpx;
}

.tip-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
  line-height: 1.6;
}
