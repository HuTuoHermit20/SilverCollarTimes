.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.faq-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.faq-a {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 12rpx 16rpx;
  background: var(--bg);
  border-radius: 8rpx;
}

.guide-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.guide-item:last-child {
  border-bottom: none;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 500;
}

.guide-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.contact-value {
  font-size: 26rpx;
  font-weight: 500;
}
