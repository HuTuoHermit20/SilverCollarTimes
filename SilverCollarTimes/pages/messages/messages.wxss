.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
}

.msg-tabs {
  display: flex;
  background: var(--bg-card);
  padding: 8rpx;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
}

.msg-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 8rpx;
  position: relative;
}

.msg-tab.active {
  background: var(--primary);
  color: #FFF;
}

.tab-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #FFF;
  font-size: 20rpx;
  margin-left: 8rpx;
  padding: 0 6rpx;
}

.tab-badge.danger {
  background: #FF3B30;
}

.msg-actions {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx 8rpx;
}

.action-link {
  font-size: 24rpx;
  color: var(--primary);
}

.msg-list {
  padding: 0 24rpx;
}

.msg-card {
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
  display: flex;
  align-items: flex-start;
  position: relative;
}

.msg-card.unread {
  border-left: 6rpx solid var(--primary);
}

.msg-card.urgent-card {
  border-left: 6rpx solid #FF3B30;
  background: rgba(255, 59, 48, 0.03);
}

.msg-left {
  position: relative;
  margin-right: 16rpx;
}

.msg-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.msg-icon.sos { background: rgba(255,59,48,0.15); color: #FF3B30; }
.msg-icon.medicine { background: rgba(52,199,89,0.15); }
.msg-icon.missed { background: rgba(255,149,0,0.15); }
.msg-icon.battery { background: rgba(255,149,0,0.15); }
.msg-icon.temperature { background: rgba(74,144,217,0.15); }

.unread-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-title {
  font-size: 28rpx;
  font-weight: 600;
}

.msg-content {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.msg-right {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 12rpx;
}

.urgent-btn {
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  white-space: nowrap;
  text-align: center;
}

.call-btn {
  background: var(--primary);
  color: #FFF;
}

.done-btn {
  background: rgba(255,59,48,0.1);
  color: #FF3B30;
}

.msg-delete {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}
