.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
}

.profile-header {
  background: linear-gradient(135deg, #4A90D9 0%, #7AB8F5 100%);
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-placeholder {
  font-size: 48rpx;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFF;
}

.profile-days {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.family-list {
  margin-bottom: 8rpx;
}

.family-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.family-item:last-child {
  border-bottom: none;
}

.family-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.family-info {
  flex: 1;
}

.family-name {
  font-size: 28rpx;
  font-weight: 500;
}

.family-role {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.tag-primary {
  background: rgba(74,144,217,0.1);
  color: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.service-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.service-item {
  padding: 16rpx;
}

.service-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.service-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
}

.setting-value {
  font-size: 26rpx;
  color: var(--text-hint);
}

.setting-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
}

.debug-card {
  margin-top: 24rpx;
}

.debug-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.debug-grid .btn {
  flex: 1;
  min-width: 160rpx;
}

.logout-btn {
  margin: 48rpx 24rpx;
}
