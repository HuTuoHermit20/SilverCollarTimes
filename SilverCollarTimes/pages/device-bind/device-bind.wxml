<view class="container">
  <view class="bind-header">
    <view class="bind-icon">📱</view>
    <view class="bind-title">绑定智能药箱</view>
    <view class="bind-desc">扫描药箱底部二维码，通过蓝牙完成绑定</view>
  </view>

  <view class="step-indicator">
    <view class="step {{currentStep >= 1 ? 'active' : ''}} {{currentStep > 1 ? 'done' : ''}}">
      <view class="step-num">1</view>
      <view class="step-label">扫码</view>
    </view>
    <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="step {{currentStep >= 2 ? 'active' : ''}} {{currentStep > 2 ? 'done' : ''}}">
      <view class="step-num">2</view>
      <view class="step-label">蓝牙扫描</view>
    </view>
    <view class="step-line {{currentStep >= 3 ? 'active' : ''}}"></view>
    <view class="step {{currentStep >= 3 ? 'active' : ''}}">
      <view class="step-num">3</view>
      <view class="step-label">连接绑定</view>
    </view>
  </view>

  <view class="btn btn-primary bind-btn" bindtap="startScan">扫码绑定</view>

  <view class="card" wx:if="{{scanResult}}">
    <view class="section-title">扫码结果</view>
    <view class="scan-info">
      <view class="info-row">
        <view class="info-label">设备ID</view>
        <view class="info-value">{{scanResult.deviceId}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">设备名称</view>
        <view class="info-value">{{scanResult.deviceName}}</view>
      </view>
    </view>
    <view class="btn btn-primary mt-16" bindtap="startBluetoothScan">搜索蓝牙设备</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'scanning'}}">
    <view class="section-title">
      <view class="flex-row">
        <view class="scanning-dot"></view>
        <text>正在搜索蓝牙设备...</text>
      </view>
    </view>
    <view class="bluetooth-tip">请确保药箱已通电且在手机附近</view>
    <view class="btn btn-outline mt-16" bindtap="stopBluetoothScan">停止搜索</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'found' && foundDevices.length > 0}}">
    <view class="section-title">发现的设备</view>
    <view class="device-list">
      <view class="ble-device-item" wx:for="{{foundDevices}}" wx:key="deviceId">
        <view class="flex-between">
          <view class="flex-row">
            <view class="ble-icon">📶</view>
            <view class="ml-16">
              <view class="ble-name">{{item.name}}</view>
              <view class="ble-id">{{item.deviceId}}</view>
            </view>
          </view>
          <view class="ble-rssi">信号: {{item.RSSI}}dBm</view>
        </view>
        <view class="btn btn-sm btn-primary mt-12" bindtap="connectToDevice" data-device="{{item}}">连接此设备</view>
      </view>
    </view>
    <view class="btn btn-outline mt-16" bindtap="startBluetoothScan">重新搜索</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'scanning' && foundDevices.length === 0 && scanDuration > 5}}">
    <view class="empty-state">
      <view class="empty-icon">🔍</view>
      <view class="empty-text">未发现药箱设备</view>
      <view class="empty-sub">请确认药箱已通电、蓝牙已开启</view>
    </view>
    <view class="btn btn-outline mt-16" bindtap="startBluetoothScan">重新搜索</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'connecting'}}">
    <view class="section-title">
      <view class="flex-row">
        <view class="scanning-dot"></view>
        <text>正在连接设备...</text>
      </view>
    </view>
    <view class="bluetooth-tip">正在与 {{connectingDeviceName}} 建立蓝牙连接</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'connected'}}">
    <view class="section-title">连接成功</view>
    <view class="flex-row">
      <view class="ble-icon connected">✓</view>
      <view class="ml-16">
        <view class="ble-name">{{connectedDeviceName}}</view>
        <view class="text-success mt-4">蓝牙已连接</view>
      </view>
    </view>
    <view class="btn btn-primary mt-16" bindtap="completeBinding">完成绑定</view>
  </view>

  <view class="card" wx:if="{{bluetoothState === 'error'}}">
    <view class="section-title text-danger">连接失败</view>
    <view class="bluetooth-tip">{{errorMessage}}</view>
    <view class="btn btn-outline mt-16" bindtap="startBluetoothScan">重试</view>
  </view>

  <view class="card" wx:if="{{devices.length > 0}}">
    <view class="section-title">已绑定设备</view>
    <view class="device-list">
      <view class="device-item" wx:for="{{devices}}" wx:key="deviceId">
        <view class="flex-between" bindtap="goDeviceDetail" data-id="{{item.deviceId}}">
          <view class="flex-row">
            <view class="device-icon">💊</view>
            <view class="ml-16">
              <view class="device-name">{{item.name}}</view>
              <view class="flex-row mt-8">
                <view class="status-dot {{item.online ? 'online' : 'offline'}}"></view>
                <text class="text-hint ml-8">{{item.online ? '在线' : '离线'}}</text>
              </view>
            </view>
          </view>
          <view class="text-hint">{{item.battery}}%</view>
        </view>
        <view class="unbind-btn" catchtap="unbindDevice" data-id="{{item.deviceId}}">解绑</view>
      </view>
    </view>
  </view>

  <view wx:if="{{devices.length === 0 && !scanResult}}" class="empty-state">
    <view class="empty-icon">📦</view>
    <view class="empty-text">您还没有绑定药箱</view>
  </view>
</view>
