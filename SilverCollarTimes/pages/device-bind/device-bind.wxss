.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.bind-header {
  text-align: center;
  padding: 60rpx 32rpx 40rpx;
}

.bind-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.bind-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.bind-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.bind-btn {
  margin: 0 24rpx 32rpx;
}

.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx 32rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-hint);
  transition: all 0.3s;
}

.step.active .step-num {
  background: var(--primary);
  border-color: var(--primary);
  color: #FFF;
}

.step.done .step-num {
  background: var(--success);
  border-color: var(--success);
  color: #FFF;
}

.step-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.step.active .step-label {
  color: var(--primary);
}

.step.done .step-label {
  color: var(--success);
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: var(--border);
  margin: 0 8rpx;
  margin-bottom: 24rpx;
}

.step-line.active {
  background: var(--primary);
}

.scan-info {
  padding: 8rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.info-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.scanning-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 12rpx;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

.bluetooth-tip {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
  line-height: 1.6;
}

.ble-device-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.ble-device-item:last-child {
  border-bottom: none;
}

.ble-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(74,144,217,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.ble-icon.connected {
  background: rgba(52,199,89,0.15);
  color: var(--success);
  font-weight: bold;
}

.ble-name {
  font-size: 28rpx;
  font-weight: 500;
}

.ble-id {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.ble-rssi {
  font-size: 22rpx;
  color: var(--text-hint);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.device-list {
  margin-top: 8rpx;
}

.device-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
  position: relative;
}

.device-item:last-child {
  border-bottom: none;
}

.device-icon {
  font-size: 48rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
}

.unbind-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: var(--danger);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}
