<view class="container {{fontMode === 'large' ? 'large-font' : ''}}">
  <view class="view-tabs">
    <view class="tab-item {{currentView === 'day' ? 'active' : ''}}" bindtap="switchView" data-view="day">日视图</view>
    <view class="tab-item {{currentView === 'week' ? 'active' : ''}}" bindtap="switchView" data-view="week">周视图</view>
    <view class="tab-item {{currentView === 'month' ? 'active' : ''}}" bindtap="switchView" data-view="month">月视图</view>
  </view>

  <!-- 日视图 -->
  <view class="day-view" wx:if="{{currentView === 'day'}}">
    <view class="filter-bar">
      <picker mode="selector" range="{{statusFilters}}" value="{{statusFilterIndex}}" bindchange="onStatusFilter">
        <view class="filter-item">{{statusFilters[statusFilterIndex]}}</view>
      </picker>
    </view>

    <view wx:if="{{dayRecords.length === 0}}" class="empty-state">
      <view class="empty-icon">📅</view>
      <view class="empty-text">未来记录将在这里显示</view>
    </view>

    <view class="timeline" wx:if="{{dayRecords.length > 0}}">
      <view class="timeline-item" wx:for="{{dayRecords}}" wx:key="id">
        <view class="timeline-dot {{item.statusClass}}"></view>
        <view class="timeline-content">
          <view class="flex-between">
            <view class="timeline-time">
              <text class="planned">{{item.plannedTime}}</text>
              <text wx:if="{{item.actualTime}}" class="actual"> → {{item.actualTime}}</text>
            </view>
            <view class="tag {{item.statusTagClass}}">{{item.statusText}}</view>
          </view>
          <view class="timeline-medicine">{{item.medicineName}} {{item.dosage}}{{item.unit}}</view>
          <view class="timeline-slot">药格 #{{item.slot}}</view>
          <view class="timeline-delay" wx:if="{{item.delayMinutes > 0}}">延迟 {{item.delayMinutes}} 分钟</view>
          <view class="timeline-supplement" wx:if="{{item.isSupplement}}">补录</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 周视图 -->
  <view class="week-view" wx:if="{{currentView === 'week'}}">
    <view class="week-grid">
      <view class="week-cell" wx:for="{{weekDays}}" wx:key="date" bindtap="selectDay" data-date="{{item.date}}">
        <view class="week-day">{{item.dayName}}</view>
        <view class="week-date {{item.isToday ? 'today' : ''}}">{{item.day}}</view>
        <view class="week-ring" wx:if="{{item.hasRecords}}">
          <view class="mini-ring" style="background: conic-gradient(#34C759 {{item.rate * 3.6}}deg, #E8ECF1 {{item.rate * 3.6}}deg)"></view>
          <view class="mini-inner">{{item.rate}}%</view>
        </view>
        <view class="week-no-data" wx:else>-</view>
      </view>
    </view>
  </view>

  <!-- 月视图 -->
  <view class="month-view" wx:if="{{currentView === 'month'}}">
    <view class="month-header flex-between">
      <view bindtap="prevMonth">◀</view>
      <view>{{monthYear}}</view>
      <view bindtap="nextMonth">▶</view>
    </view>
    <view class="month-grid">
      <view class="month-weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
      <view class="month-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}}"
        wx:for="{{monthDays}}" wx:key="date"
        bindtap="selectDay" data-date="{{item.date}}"
        style="background: {{item.color}}">
        <view class="month-day">{{item.day}}</view>
        <view class="month-rate" wx:if="{{item.rate !== null}}">{{item.rate}}%</view>
      </view>
    </view>
  </view>

  <!-- 依从率统计 -->
  <view class="card stats-card">
    <view class="section-title">依从率统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value text-success">{{stats.weekRate}}%</view>
        <view class="stat-label">本周依从率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value text-primary">{{stats.monthRate}}%</view>
        <view class="stat-label">本月依从率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value text-warning">{{stats.consecutiveDays}}</view>
        <view class="stat-label">连续按时天数</view>
      </view>
    </view>
    <view class="btn btn-outline mt-24" bindtap="generateReport">生成服药报告</view>
  </view>
</view>
