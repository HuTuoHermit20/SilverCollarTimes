.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
}

.picker-value {
  font-size: 26rpx;
  color: var(--primary);
}
