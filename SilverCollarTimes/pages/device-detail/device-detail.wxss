.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.device-info-card {
  margin-top: 16rpx;
}

.device-icon {
  font-size: 56rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
}

.device-stats {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.stat-row {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.settings-list {
  margin-top: 16rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.setting-row slider {
  flex: 1;
}

.picker-value {
  font-size: 26rpx;
  color: var(--primary);
}

.setting-input {
  width: 100rpx;
  height: 56rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  margin-right: 8rpx;
}

.update-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-left: 8rpx;
}

.unbind-btn {
  margin: 48rpx 24rpx;
}
